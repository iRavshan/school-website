# ====================================================================
# MULTIPURPOSE SAMPLE GITIGNORE
# ====================================================================

# --- Environment & Security (NEVER COMMIT SECRETS) ---
.env
.env.local
.env.*.local
*.pem
*.key
*.cert

# --- Operating System Files ---
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# Linux
*~
.fuse_hidden*
.directory

# --- Common Package Managers & Dependencies ---
node_modules/
jspm_packages/
bower_components/
.npm/
vendor/
.pnp/
.pnp.js

# --- Build Outputs and Cache ---
dist/
build/
out/
bin/
obj/
*.exe
*.dll
*.so
*.dylib
.cache/
.parcel-cache/
.eslintcache

# --- Log Files ---
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- Editor and IDE Specifics ---
# VS Code
.vscode/
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace

# IntelliJ / WebStorm / PyCharm
.idea/
*.iml
*.iws

# Visual Studio
*.suo
*.user
*.userosscache
*.sln.docstates

# --- Testing and Coverage ---
coverage/
.nyc_output/
htmlcov/
.pytest_cache/

# --- Optional: Local configuration files ---
config/local.json
config/local.js